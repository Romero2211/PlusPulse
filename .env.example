# Скопіюйте у .env і за потреби змініть шлях.
# Файл SQLite створюється в каталозі prisma/ після міграції.
DATABASE_URL="file:./dev.db"

# Секрет для підпису сесій (мінімум 32 символи). Приклад: openssl rand -base64 32
AUTH_SECRET=""

# Доступ до /admin (список email через кому)
# ADMIN_EMAILS="admin@example.com,another@example.com"

# Google Gemini (AI Studio) — перевірка назви, мети та опису заходу перед збереженням.
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Альтернативна назва змінної:
# GOOGLE_AI_API_KEY=""
# Модель (див. список у AI Studio або документації; типово: gemini-2.0-flash).
# GEMINI_MODEL=""

# Автоматична перевірка вимкнена повністю: 1 або true
# EVENT_AI_DISABLED=

# При збої API (таймаут, помилка мережі, парсинг) або неоднозначній відповіді AI заявка потрапляє в /admin/events на ручне схвалення.

# Лог результату перевірки в термінал: у prod увімкнути через 1/true; у dev вимкнути — 0
# EVENT_AI_DEBUG=

# Таймаут запиту до API (мс), за замовчуванням 28000.
# EVENT_AI_TIMEOUT_MS=
