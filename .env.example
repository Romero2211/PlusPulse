# Скопіюйте у .env для локальної розробки (після `docker compose up -d`).

# PostgreSQL — підключення для застосунку (Prisma Client).
# Локально: docker-compose на порту 5433.
DATABASE_URL="postgresql://pluspulse:pluspulse@127.0.0.1:5433/pluspulse?schema=public"

# Пряме підключення для міграцій (prisma migrate).
# Локально може збігатися з DATABASE_URL.
# Neon: pooled URL у DATABASE_URL, direct — у DIRECT_DATABASE_URL.
# Vercel Postgres: POSTGRES_PRISMA_URL → DATABASE_URL, POSTGRES_URL_NON_POOLING → DIRECT_DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://pluspulse:pluspulse@127.0.0.1:5433/pluspulse?schema=public"

# Секрет для підпису сесій (мінімум 32 символи). Приклад: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (вхід / реєстрація через Google)
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://YOUR_DOMAIN/api/auth/google/callback (локально: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Показати кнопку Google у модалці входу (Header): 1
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="1"
# Публічний URL сайту для OAuth redirect (production)
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Доступ до /admin (список email через кому)
# ADMIN_EMAILS="admin@example.com,another@example.com"

# Google Gemini (AI Studio) — перевірка назви, мети та опису заходу перед збереженням.
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Альтернативна назва змінної:
# GOOGLE_AI_API_KEY=""
# Модель (див. список у AI Studio або документації; типово: gemini-2.0-flash).
# GEMINI_MODEL=""

# Автоматична перевірка вимкнена повністю: 1 або true
# EVENT_AI_DISABLED=

# При збої API (таймаут, помилка мережі, парсинг) або неоднозначній відповіді AI заявка потрапляє в /admin/events на ручне схвалення.

# Лог результату перевірки в термінал: у prod увімкнути через 1/true; у dev вимкнути — 0
# EVENT_AI_DEBUG=

# Таймаут запиту до API (мс), за замовчуванням 28000.
# EVENT_AI_TIMEOUT_MS=

# Інтеграційні тести (Playwright) — окрема БД, за замовчуванням той самий docker-compose.
# TEST_DATABASE_URL="postgresql://pluspulse:pluspulse@127.0.0.1:5433/pluspulse_test?schema=public"
