{
  "name": "plus-pulse-charity",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Благодійна організація «Благодійний фонд «ПЛЮС ПУЛЬС»",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:cinimex": "node scripts/run-cinimex-scenarios.mjs",
    "metrics": "node scripts/code-metrics-report.mjs",
    "test:integration": "playwright test -c tests/integration/playwright.config.ts",
    "test:integration:headed": "playwright test -c tests/integration/playwright.config.ts --headed"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "next": "15.4.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@playwright/test": "^1.54.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.4.10",
    "prisma": "^6.3.1",
    "typescript": "^5.0.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0"
  }
}
